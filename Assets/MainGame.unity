--- !u!114 &8482399
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8482396}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9825b61c4b1ce804c9883efde95e1f6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  speakerImage: {fileID: 1312327599}
  speakerText: {fileID: 896398905}
  dialogueText: {fileID: 1336293272}
  dialoguePanel: {fileID: 884131703}
  continueIndicator: {fileID: 0}
  dialogueLines:
  - speaker: Charlotte
    speakerImage: {fileID: 21300000, guid: 8ed1a8c493f75164d94b8831ace10c2c, type: 3}
    text: 'Oh, you are awake! Let me briefly introduce myself: I''m Charlotte, you
      fainted outside the gate and I secretly brought you into the  "Safe Zone:'
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: Uh...Thank you very much Ms.Charlotte, but I don't quite understand what
      are you talking about? What's Safe Zone?
  - speaker: Charlotte
    speakerImage: {fileID: 21300000, guid: 68f4bd12147c03a409799a3e3318daa4, type: 3}
    text: Um....that's unusual, I thought everyone alive would know......anyway,
      the Safe Zone is kind of a community raised by the original government, and
      we block the infected zone away using walls and stuff to keep us safe.
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: And....What's the infected zone you've mentioned?
  - speaker: Charlotte
    speakerImage: {fileID: 21300000, guid: 68f4bd12147c03a409799a3e3318daa4, type: 3}
    text: Did you loss your memories? The infected zone is.....basically every other
      place outside the wall, it's full of zombies and half-infected ones
  - speaker: Player
    speakerImage: {fileID: -143273995, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: Zombies....? So everybody alive is here?
  - speaker: Charlotte
    speakerImage: {fileID: 21300000, guid: b62c4d198e0d383439906e7c3e7bc067, type: 3}
    text: Probably.....Though I've once saw.....Any way, you are the lucky ones,
      feel free to get around. Follow the light. (Press F at the near street lamp
      to learn about keyboard settings)
  dialogueId: Intro_Charlotte
  isQuestDialogue: 1
  enableEnemySpawningAfterComplete: 0
  isOneTimeDialogue: 0
  useGlobalId: 0
  typingSpeed: 0.05
  continueKey: 102
  startKey: 102
  isEnter: 0
  dayManager: {fileID: 1524982362}
  advanceDayOnComplete: 1
  disablePlayerControlDuringDialogue: 1
  disableWeaponsDuringDialogue: 1
  hasBeenTriggered: 0
  NextNPC: {fileID: 1934796612}
