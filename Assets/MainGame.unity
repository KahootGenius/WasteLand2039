MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 579311912}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9825b61c4b1ce804c9883efde95e1f6f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  speakerImage: {fileID: 1312327599}
  speakerText: {fileID: 896398905}
  dialogueText: {fileID: 1336293272}
  dialoguePanel: {fileID: 884131703}
  continueIndicator: {fileID: 0}
  dialogueLines:
  - speaker: Player
    speakerImage: {fileID: -143273995, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: (Press F to enter dialogue)
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: (Left Click or Space to shoot)
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: (R to reload, need bullet in your bag)
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: (Tab to open inventory)
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: (E to interact)
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: (Press L near the main base to heal)
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: (Press F near the main base to fix it)
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: 'Main Quest: Protect the Main Base, Discover the truth behind the Safe
      Zone'
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: 'Next Step: Break the Red Car to exit Safe Zone'
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: Zombies will start spawning after you finish this dialogue, you can get
      any raw material from killing zombies
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: 'Recommendation: Don''t get too far before you have enough base fixing
      material'
  - speaker: Player
    speakerImage: {fileID: 991482917, guid: 7e92a83a1f82fbf4dae12237c10fe342, type: 3}
    text: Remember, you need bullet to fight, craft bullet at the crafting table
      beside (Press E)
  dialogueId: Keyboard
  isQuestDialogue: 1
  enableEnemySpawningAfterComplete: 1
  isOneTimeDialogue: 0
  useGlobalId: 0
  typingSpeed: 0.05
